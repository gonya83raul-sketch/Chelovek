+.ttl :is(h1,h2){grid-area:t}
 .ttl p{grid-area:l}
 .tbtns{grid-area:b;justify-self:start;display:flex;gap:6px;pointer-events:auto}
 .ibtn{width:30px;height:30px;display:grid;place-items:center;padding:0;border-radius:50%;border:1px solid var(--line-2);background:color-mix(in srgb,var(--stage) 55%,transparent);color:var(--mute);cursor:pointer;transition:color .15s var(--ease),border-color .15s var(--ease)}
 .ibtn:hover{color:var(--fg);border-color:var(--dim)}
 .ibtn svg{width:16px;height:16px}
+.ibtn[hidden],.ibtn .ir,.ibtn[aria-pressed="true"] .ip{display:none}
+.ibtn[aria-pressed="true"] .ir{display:inline}
+.ibtn[aria-pressed="true"]{color:var(--accent);border-color:var(--accent)}
 /* поиск по темам */
 .pill kbd,.fhint kbd{font:500 11px/1 var(--f-body);color:var(--dim);border:1px solid var(--line-2);border-radius:5px;padding:2px 5px}
 .srch{color:var(--mute)}
